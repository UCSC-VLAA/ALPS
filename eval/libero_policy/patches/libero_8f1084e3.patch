--- /dev/null
+++ b/libero/lifelong/models/modules/frozen_encoder_pool.py
@@ -0,0 +1,23 @@
+# Copyright 2026 The ALPS Authors.
+# SPDX-License-Identifier: Apache-2.0
+"""Frozen-encoder image module of the LIBERO policies of the ALPS paper (`network: FrozenEncoderPool`,
+libero/configs/policy/image_encoder/frozen_encoder_pool.yaml).
+
+The implementation is eval/libero_policy/frozen_encoder_bridge.py of the ALPS repository; set ALPS_REPO to the root of that
+repository (the scripts in eval/libero_policy/scripts do). As in the paper's runs, importing it enables TF32 matrix products
+in the whole process."""
+import os
+import sys
+
+_ALPS_REPO = os.environ.get("ALPS_REPO", "")
+if _ALPS_REPO and os.path.abspath(_ALPS_REPO) not in sys.path:
+    sys.path.append(os.path.abspath(_ALPS_REPO))
+
+try:
+    from eval.libero_policy.frozen_encoder_bridge import FrozenEncoderPool  # noqa: F401
+except ImportError as _err:  # keep LIBERO usable without the ALPS repository (e.g. for its ResNet policies)
+    _IMPORT_ERROR = _err
+
+    class FrozenEncoderPool:
+        def __init__(self, *args, **kwargs):
+            raise ImportError("FrozenEncoderPool needs the ALPS repository (set ALPS_REPO to its root): %s" % _IMPORT_ERROR)
