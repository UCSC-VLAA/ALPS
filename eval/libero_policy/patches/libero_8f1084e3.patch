diff --git a/libero/lifelong/datasets.py b/libero/lifelong/datasets.py
index f0b5a1c..052282b 100644
--- a/libero/lifelong/datasets.py
+++ b/libero/lifelong/datasets.py
@@ -137,3 +137,19 @@ class TruncatedSequenceDataset(Dataset):
 
     def __getitem__(self, idx):
         return self.sequence_dataset.__getitem__(idx)
+
+
+def h5_worker_init(_worker_id):
+    """DataLoader worker_init_fn (fork context): drop the hdf5 handles inherited from the parent, so that every worker
+    reopens its files lazily (robomimic's SequenceDataset.hdf5_file property)."""
+    import torch.utils.data as tud
+
+    stack = [tud.get_worker_info().dataset]
+    while stack:
+        d = stack.pop()
+        if hasattr(d, "datasets"):
+            stack.extend(d.datasets)
+        if hasattr(d, "sequence_dataset"):
+            stack.append(d.sequence_dataset)
+        if hasattr(d, "_hdf5_file"):
+            d._hdf5_file = None
