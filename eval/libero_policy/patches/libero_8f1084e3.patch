@@ -0,0 +1,16 @@
+# Frozen encoder + language-conditioned attention pool of the ALPS paper's LIBERO policies, a drop-in for
+# resnet_encoder.yaml. Choose the encoder with network_kwargs.encoder (and .weights); every key is explained in
+# eval/libero_policy/README.md of the ALPS repository. Defaults: a truly frozen encoder and the released model's arithmetic;
+# the paper's runs used encoder_train_mode=follow and, for ALPS, alps_port_numerics=true (scripts/run_paper_policies.sh).
+network: FrozenEncoderPool
+network_kwargs:
+    encoder: ""
+    weights: ""
+    num_queries: 1
+    pool_heads: 4
+    language_fusion: 'film'
+    flip_ud: true
+    resize: 224
+    autocast_dtype: bfloat16
+    encoder_train_mode: eval
+    alps_port_numerics: false
