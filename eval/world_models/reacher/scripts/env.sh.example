# Environment of the Reacher (LeWorldModel) scripts (copy to env.sh, edit, then `source env.sh`).
export LEWM_ROOT=/path/to/le-wm                 # github.com/lucas-maes/le-wm at 8edfeb33 + le_wm.patch (scripts/setup_lewm.sh)
export SWM_ROOT=/path/to/stable-worldmodel      # github.com/galilai-group/stable-worldmodel at 63988116 (scripts/train/prejepa.py)
export ALPS_ROOT=/path/to/alps_release          # root of the ALPS repository (eval/encoders.py, alps/)
export REACHER_DIR=$ALPS_ROOT/eval/world_models/reacher
export STABLEWM_HOME=/path/to/stablewm_home     # reacher.h5, checkpoints/<run>/, evaluation outputs
export REACHER_OUT=/path/to/reacher_outputs     # stats/, runs/, probe_frames/, probes/, results/
export PYTHON=/path/to/py310/bin/python         # Python 3.10 environment of README (stable-worldmodel 0.1.1)
export ALPS_WEIGHTS=/path/to/alps_vitb16.safetensors
export ALPS_STAGE1_WEIGHTS=/path/to/alps_stage1_vitb16.safetensors
export RADIO_REPO=/path/to/NVlabs_RADIO
export RADIO_CKPT=/path/to/c-radio_v3-b_half.pth.tar
export HF_HOME=/path/to/hf_cache                # timm DINOv3 / SigLIP 2 weights, transformers facebook/dinov2-base
export PYTHONPATH=$REACHER_DIR:${PYTHONPATH:-}  # frozen_backbone.FrozenTokens, instantiated from the world-model configs
export MUJOCO_GL=egl
export WANDB_MODE=disabled
