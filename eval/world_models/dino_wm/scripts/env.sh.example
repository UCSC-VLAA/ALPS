# Environment of the DINO-WM world-model scripts (copy to env.sh, edit, then `source env.sh`).
export DINO_WM=/path/to/dino_wm              # DINO-WM checkout prepared by scripts/setup_dino_wm.sh
export ALPS_ROOT=/path/to/alps_release       # root of the ALPS repository (eval/encoders.py, alps/)
export DATASET_DIR=/path/to/dino_wm_data     # pusht_noise/, wall_single/, point_maze/, deformable/{rope,granular}/
export WM_ROOT=/path/to/wm_outputs           # subsets/, stats/, runs/outputs/<run>/, plan_logs/, plan_outputs/, results/
export ALPS_WEIGHTS=/path/to/alps_vitb16.safetensors
export ALPS_STAGE1_WEIGHTS=/path/to/alps_stage1_vitb16.safetensors
export RADIO_REPO=/path/to/NVlabs_RADIO      # local copy of github.com/NVlabs/RADIO (hubconf.py)
export RADIO_CKPT=/path/to/c-radio_v3-b_half.pth.tar
export TORCH_HOME=/path/to/torch_cache       # hub/facebookresearch_dinov2_main at commit 85a24602 + hub/checkpoints (README)
export HF_HOME=/path/to/hf_cache             # timm weights of DINOv3-B/16 and SigLIP 2-B/16
export WANDB_MODE=offline                    # DINO-WM calls wandb.init
export SDL_VIDEODRIVER=dummy
export HYDRA_FULL_ERROR=1
# PointMaze (mujoco-py): MuJoCo 2.1.0 binaries and the GL / GLEW / EGL libraries mujoco-py was built against
export MUJOCO_PY_MUJOCO_PATH=/path/to/mujoco210
export GL_LIBS=/path/to/conda_env_with_glew_mesalib/lib
export LD_LIBRARY_PATH=$MUJOCO_PY_MUJOCO_PATH/bin:/usr/lib/nvidia:$GL_LIBS:${LD_LIBRARY_PATH:-}
# Granular and Rope (PyFleX built from AdaptiGraph)
export PYFLEXROOT=/path/to/AdaptiGraph/PyFleX
export PYTHONPATH=$PYFLEXROOT/bindings/build:${PYTHONPATH:-}
export LD_LIBRARY_PATH=$PYFLEXROOT/external/SDL2-2.0.4/lib/x64:$LD_LIBRARY_PATH
